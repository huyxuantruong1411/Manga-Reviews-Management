              "en": "Action",
              "vi": "Hành động"
            }
          }
        ],
        "links": [
          {
            "site": "MangaDex",
            "url": "https://mangadex.org/title/00000000-0000-4000-8000-000000000001"
          }
        ],
        "primary_cover": {
          "bucket": "manga-library",
          "object_key": "covers/example-manga/main.webp",
          "content_type": null,
          "width": null,
          "height": null,
          "file_size": 0,
          "md5_hash": null,
          "sha256": null
        },
        "cover_arts": [
          {
            "cover_id": "cov_v1",
            "volume": "1",
            "locale": "ja",
            "description": null,
            "media": {
              "bucket": "manga-library",
              "object_key": "covers/example-manga/v1.webp",
              "content_type": null,
              "width": null,
              "height": null,
              "file_size": 0,
              "md5_hash": null,
              "sha256": null
            }
          }
        ],
        "stats": {
          "chapter_count": 1,
          "page_count": 1,
          "total_size_bytes": 245760,
          "languages": [
            "en"
