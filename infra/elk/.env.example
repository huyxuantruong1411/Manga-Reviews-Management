# Elastic Stack Environment Variables (Local Development)
ELASTIC_VERSION=8.17.0

# Superuser password for Elasticsearch
ELASTIC_PASSWORD=changeme_elastic_super_secret_password

# Internal Kibana system user password
KIBANA_PASSWORD=changeme_kibana_system_password

# Kibana encryption keys (must be >= 32 characters)
KIBANA_ENCRYPTION_KEY=changeme_at_least_32_random_bytes_key_here

# Anonymous Viewer credentials for embedded Kibana iframe on localhost
KIBANA_VIEWER_PASSWORD=changeme_kibana_viewer_password

# Logstash writer account password
LOGSTASH_WRITER_PASSWORD=changeme_logstash_writer_password

# Application credentials for FastAPI backend (manga_app user)
APP_ES_PASSWORD=changeme_manga_app_password
