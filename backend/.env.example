# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=manga_library
POOL_DATABASE_NAME=manga_datalake_pool

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_local_access_key
MINIO_SECRET_KEY=replace_with_strong_local_secret
MINIO_BUCKET=manga-library

# Redis & Background Task Queue (ARQ)
REDIS_URL=redis://127.0.0.1:6379/0

# Local Storage Directory for Chapter Downloads
DOWNLOAD_DIR=./downloads

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Google Gemini API Key (for AI Reviews & Scene Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# MangaDex API Credentials (Optional: required for personal client API authentication)
MANGADEX_PROXY=
MANGADEX_CLIENT_ID=your_mangadex_client_id_here
MANGADEX_CLIENT_SECRET=your_mangadex_client_secret_here
MANGADEX_USERNAME=your_mangadex_username_here
MANGADEX_PASSWORD=your_mangadex_password_here

# Structured Logging (ECS)
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_ENABLED=false
LOG_DIR=logs
SERVICE_ENVIRONMENT=dev

# Elasticsearch & Kibana (Optional: ELK Stack integration)
ES_ENABLED=false
ES_URL=http://127.0.0.1:9200
ES_USERNAME=manga_app
ES_PASSWORD=replace_with_elk_app_password
AUDIT_ES_SYNC_ENABLED=false
AUDIT_ES_SEARCH_ENABLED=false
KIBANA_URL=http://127.0.0.1:5601

# Comix Datasource & Anti-Bot / Local AI CAPTCHA Configuration
DATASOURCE_COMIX_ENABLED=true
DATASOURCE_COMIX_BASE_URL=https://comix.to
DATASOURCE_COMIX_TRANSPORT=stealth_auto
DATASOURCE_COMIX_MAX_CONCURRENT_CHAPTERS=1
DATASOURCE_COMIX_MAX_CONCURRENT_PAGES=2
DATASOURCE_COMIX_RATE_LIMIT_RPM=30

# Local AI CAPTCHA & Session Bypass
DATASOURCE_CAPTCHA_AUTO_SOLVE_ENABLED=true
DATASOURCE_CAPTCHA_MAX_ATTEMPTS=3
DATASOURCE_CAPTCHA_VLM_PROVIDER=local_or_gemini
DATASOURCE_CAPTCHA_OLLAMA_URL=http://127.0.0.1:11434
DATASOURCE_CAPTCHA_OLLAMA_MODEL=qwen2.5-vl:7b
DATASOURCE_CAPTCHA_SIDECAR_URL=
DATASOURCE_SESSION_DIR=backend/data/datasource-sessions

# External Source Connector (Third-party Manga Source Gateway for Downstream Reader ETL/CDC)
CONNECTOR_ENABLED=true
CONNECTOR_SOURCE_SYSTEM=manga-datalake-pool
CONNECTOR_HOST=127.0.0.1
CONNECTOR_PORT=8001
CONNECTOR_API_KEY=replace_with_strong_random_connector_api_key
CONNECTOR_WEBHOOK_SECRET=replace_with_strong_random_webhook_hmac_secret
CONNECTOR_ALLOW_UNAUTHENTICATED_LOCAL=false
CONNECTOR_ENFORCE_TUNNEL_PATH_GUARD=true
CONNECTOR_PUBLIC_BASE_URL=
CONNECTOR_NGROK_API_URL=http://127.0.0.1:4040/api/tunnels
CONNECTOR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONNECTOR_WEBHOOK_TIMEOUT_S=10.0
CONNECTOR_WEBHOOK_MAX_RETRIES=3
CONNECTOR_WEBHOOK_ALLOW_PRIVATE_URLS=true

# Manga Deep Analytics Lab (Medallion OLAP Arrow Serving & Offline Pipeline)
ANALYTICS_HOME=.local/analytics
ANALYTICS_LAB_ALLOWED_ORIGINS=
# ANALYTICS_MONGODB_URI=mongodb://analytics_ro:replace_with_readonly_password@localhost:27017
