# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=manga_library

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_local_access_key
MINIO_SECRET_KEY=replace_with_strong_local_secret
MINIO_BUCKET=manga-library

# Redis & Background Task Queue (ARQ)
REDIS_URL=redis://127.0.0.1:6379/0

# Local Storage Directory for Chapter Downloads
DOWNLOAD_DIR=./downloads

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Google Gemini API Key (for AI Reviews & Scene Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# MangaDex API Credentials (Optional: required for personal client API authentication)
MANGADEX_PROXY=
MANGADEX_CLIENT_ID=your_mangadex_client_id_here
MANGADEX_CLIENT_SECRET=your_mangadex_client_secret_here
MANGADEX_USERNAME=your_mangadex_username_here
MANGADEX_PASSWORD=your_mangadex_password_here

# Structured Logging (ECS)
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_FILE_ENABLED=false
LOG_DIR=logs
SERVICE_ENVIRONMENT=dev

# Elasticsearch & Kibana (Optional: ELK Stack integration)
ES_ENABLED=false
ES_URL=http://127.0.0.1:9200
ES_USERNAME=manga_app
ES_PASSWORD=replace_with_elk_app_password
AUDIT_ES_SYNC_ENABLED=false
AUDIT_ES_SEARCH_ENABLED=false
KIBANA_URL=http://127.0.0.1:5601
